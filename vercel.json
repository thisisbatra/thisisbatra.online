{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "functions": { "api/contact.mjs": { "maxDuration": 60 } },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
